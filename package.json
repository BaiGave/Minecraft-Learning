{
  "name": "minecraft-learning",
  "version": "1.0.0",
  "description": "Minecraft Learning — static docs site (MC / Iris / Sodium tutorials & analysis)",
  "main": "convert.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:css && npm run copy:libs && node convert.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./styles/tailwind.css --minify",
    "copy:libs": "node scripts/copy-libs.js",
    "dev:css": "tailwindcss -i ./src/tailwind.css -o ./styles/tailwind.css --watch",
    "dev": "npm run dev:css & node watch.js",
    "preview": "npx serve . -l 3000",
    "clean": "rimraf docs tutorials styles/tailwind.css lib"
  },
  "keywords": [
    "minecraft",
    "minecraft-learning",
    "tutorial",
    "static-site",
    "markdown",
    "docs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "serve": "^14.2.0"
  },
  "dependencies": {
    "lucide-static": "latest",
    "flexsearch": "^0.7.43",
    "countup.js": "^2.8.0",
    "highlight.js": "^11.9.0",
    "mermaid": "^10.8.0",
    "@fortawesome/fontawesome-free": "^6.5.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
