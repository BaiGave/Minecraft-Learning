{
  "name": "minecraft-learning",
  "version": "1.0.0",
  "description": "Minecraft Learning — static docs site (MC / Iris / Sodium tutorials & analysis)",
  "main": "convert.js",
  "type": "commonjs",
  "scripts": {
    "build:blog": "node convert.js",
    "build:website": "cd website && node convert.js",
    "build:all": "npm run build:blog && npm run build:website",
    "seo": "node scripts/generate-seo.js",
    "dev": "cd website && node watch.js",
    "preview": "npx serve . -l 3000",
    "preview:website": "cd website && npx serve . -l 3000",
    "lint": "echo 'No linter configured'",
    "clean": "rimraf website/docs website/tutorials",
    "clean:all": "rimraf website/docs website/tutorials index.html article.html"
  },
  "keywords": [
    "minecraft",
    "minecraft-learning",
    "tutorial",
    "static-site",
    "markdown",
    "docs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "serve": "^14.2.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
